thingso.dev, www.thingso.dev {
  encode zstd gzip

  @health path /api/health
  handle @health {
    reverse_proxy web:3000
  }

  reverse_proxy web:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Robots-Tag "all"
  }

  log {
    output stdout
    format console
  }
}
